# ==============================================================================
# Repository Specifics (PDF Comparison Outputs / Test Artifacts)
# ==============================================================================
# Ignore any temporary PDF inputs or generated visual difference reports
*.pdf
!/tests/sample_data/*.pdf  # Un-ignore specific sample PDFs needed for tests if any
*.png
*.jpg
*.jpeg
/output/
/diff_results/
/temp/
/tmp/

